# ==============================================================
# Midnight Network Preprod Deployment Configuration
# ==============================================================

# 1. Midnight Preprod Wallet
# Generate a new 24-word seed phrase using Midnight Lace Wallet
# Fund your wallet with testnet tNIGHT and DUST from:
# https://faucet.preprod.midnight.network
MIDNIGHT_WALLET_SEED="your twenty four word seed phrase goes here separated by spaces"

# Optional: Merchant payout address (32-byte hex)
INITIAL_MERCHANT="0x3a9f4c82b17e4d89a23c7f9104b901e82b67f10a"

# Initial Plan ID to register with the smart contract
INITIAL_PLAN_ID=101

# 2. Midnight Preprod Endpoints
INDEXER_URL="https://indexer.preprod.midnight.network/api/v4/graphql"
INDEXER_WS_URL="wss://indexer.preprod.midnight.network/api/v4/graphql/ws"
NODE_RPC_URL="https://rpc.preprod.midnight.network"

# 3. Midnight Proof Server (Halo2 Prover)
# Required for generating zero-knowledge proofs on-chain.
# Start locally using Docker:
# docker run -d -p 6300:6300 midnightntwrk/proof-server:latest
PROOF_SERVER_URL="http://localhost:6300"
